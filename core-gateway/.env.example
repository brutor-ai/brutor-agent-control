# Brutor Agent Control, Core Gateway (Community Edition): environment variables
#
# Generated from src/env_vars.rs; do not edit by hand. To regenerate:
#   UPDATE_ENV_DOCS=1 cargo test --test env_registry
#
# Copy to .env and fill in the required values: cp .env.example .env
# The service loads .env from its working directory at start.

# PostgreSQL connection string of the database the Control Plane created and
# migrated. The gateway reads its configuration there and never alters the
# schema.
# url; required; secret; edition: both
# Accepted: a postgresql:// URL
# Example: postgresql://<user>:<password>@localhost:5432/<database>
DATABASE_URL=

# Redis (or Valkey) the gateway enforces every usage limit on and listens on
# for cache invalidation from the Control Plane. The gateway does not start
# without it. The Control Plane must use the same Redis.
# url; required; secret; edition: both
# Accepted: a redis:// or rediss:// URL
# Example: redis://<host>:6379/0
REDIS_URL=

# Secret the gateway verifies the Control Plane's tokens with and signs its
# own with. Must equal the Control Plane's JWT_SECRET. A value from an example
# file is refused.
# string; required; secret; edition: both
# Accepted: at least 32 characters, not a placeholder
# Example: <output of: openssl rand -hex 32>
JWT_SECRET=

# Decrypts the credentials the Control Plane stored (provider keys, OAuth
# tokens, client secrets) and keys the gateway's own derived secrets. Must
# equal the Control Plane's ENCRYPTION_KEY. A value from an example file is
# refused.
# string; required; secret; edition: both
# Accepted: at least 32 characters, not a placeholder
# Example: <output of: openssl rand -hex 32>
ENCRYPTION_KEY=

# Address the gateway's HTTP server binds: every /v1 route. The Control Plane
# and the workers reach the gateway at this address.
# socket_addr; default 0.0.0.0:8100; edition: both
# Accepted: host:port
# BRUTOR_GATEWAY_LISTEN_ADDR=127.0.0.1:8100

# URL at which browsers and agents reach the gateway: the base of the OAuth
# metadata, redirect URIs and the MCP endpoints it advertises. Unset:
# http://localhost:<port of BRUTOR_GATEWAY_LISTEN_ADDR>.
# url; no default; edition: both
# Accepted: an http:// or https:// URL
# BRUTOR_GATEWAY_PUBLIC_URL=https://gateway.example.com

# Origins that may read the non-protocol routes cross-origin. The Control
# Plane reads the same variable. Unset: http://localhost:3001 and
# http://localhost:3002.
# list; no default; edition: both
# Accepted: comma-separated origins (scheme://host[:port])
# BRUTOR_CORS_ORIGINS=https://admin.example.com,https://portal.example.com

# Reverse proxies whose X-Forwarded-For is believed. A request's client IP
# (audit rows, the request log, run and agent identities) is the connecting
# address unless that address is listed; then it is the right-most
# X-Forwarded-For address that is not itself listed. Forwarded and X-Real-IP
# are never read, and no URL is built from a request: OAuth metadata and
# redirect URIs come from BRUTOR_GATEWAY_PUBLIC_URL. Unset: no forwarded
# header is believed, and behind a reverse proxy its address is recorded. The
# Control Plane reads the same variable.
# list; no default; edition: both
# Accepted: comma-separated IP addresses and CIDR ranges (no host names, no *)
# BRUTOR_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10

# Algorithm of the tokens the gateway issues after an MCP OAuth exchange. Must
# equal the Control Plane's JWT_ALGORITHM.
# string; default HS256; edition: both
# Accepted: HS256, HS384 or HS512
# JWT_ALGORITHM=HS512

# Lifetime, in seconds, of the tokens the gateway issues (MCP OAuth exchange;
# portal sessions in the Enterprise Edition). The Control Plane reads the same
# variable.
# integer; default 3600; edition: both
# Accepted: a whole number of seconds, 1 or more
# JWT_EXPIRES_IN_SECS=7200

# Advanced. Most connections the gateway's PostgreSQL pool opens. The Control
# Plane reads the same variable to cap its bulk operations against the
# gateway.
# integer; default 20; edition: both
# Accepted: a whole number, 1 or more
# BRUTOR_GATEWAY_DB_POOL_SIZE=50

# Seconds the gateway waits for an MCP server that has no timeout of its own
# configured.
# integer; default 30; edition: both
# Accepted: a whole number of seconds, 1 or more
# BRUTOR_MCP_TIMEOUT_SECS=60

# Advanced. Oldest parent step, in seconds, an agent-to-agent delegation may
# name (plus 60 s for clock skew): an older one is refused as a replay. An
# agent that works longer than this on a delegated task before it delegates
# further is refused too, so raise it above the longest such task; raising it
# widens the replay window by as much.
# integer; default 600; edition: both
# Accepted: a whole number of seconds, 1 or more
# BRUTOR_A2A_DELEGATION_MAX_AGE_SECS=900

# Name of the embedding model of a tenant that has not chosen one. An agent
# needs no grant of its own for the tenant's embedding model. In the
# Enterprise Edition it is also what the knowledge base and the response cache
# embed with, and must equal the KB Uploader's and the Control Plane's
# BRUTOR_EMBEDDING_MODEL. No default.
# string; no default; edition: both
# Accepted: a model name in the tenants' catalogs
# BRUTOR_EMBEDDING_MODEL=text-embedding-3-small

# Name of the model that judges semantic policies for a tenant that has not
# chosen one. Without either, a semantic policy has no judge and says so.
# string; no default; edition: both
# Accepted: a model name in the tenants' catalogs
# BRUTOR_JUDGE_MODEL=gpt-4o-mini

# Where uploaded and generated files are kept. filesystem: files under
# BRUTOR_MEDIA_FILESYSTEM_DIR, for ONE gateway instance; the gateway serves
# their signed download links itself at /v1/media/. s3: the bucket named by
# BRUTOR_MEDIA_BUCKET, for any number of instances. memory: in the gateway's
# process, lost at restart (development and tests). Unset: filesystem when
# BRUTOR_MEDIA_FILESYSTEM_DIR is set, memory otherwise.
# string; no default; edition: both
# Accepted: filesystem, s3 or memory
# BRUTOR_MEDIA_STORAGE_BACKEND=s3

# Bucket of the media store. Required when BRUTOR_MEDIA_STORAGE_BACKEND is s3:
# the gateway refuses to start without it.
# string; no default; edition: both
# Accepted: a bucket name
# BRUTOR_MEDIA_BUCKET=brutor-media

# Region of the media bucket. Unset: AWS_REGION, and us-east-1 when that is
# unset too.
# string; no default; edition: both
# Accepted: a region name
# BRUTOR_MEDIA_S3_REGION=eu-north-1

# The AWS SDK's region. The gateway itself reads it only as the region of the
# media bucket when BRUTOR_MEDIA_S3_REGION is unset.
# string; no default; edition: both
# Accepted: a region name
# AWS_REGION=eu-north-1

# Endpoint of an S3-compatible store (MinIO, R2) as the gateway reaches it.
# Unset: AWS S3 in the region.
# url; no default; edition: both
# Accepted: an http:// or https:// URL
# BRUTOR_MEDIA_S3_ENDPOINT=http://minio:9000

# Endpoint of the same store as a browser reaches it, used only in the signed
# download URLs the gateway hands out. Set it when that differs from
# BRUTOR_MEDIA_S3_ENDPOINT (a store on a container network). Unset: the
# endpoint the gateway uses.
# url; no default; edition: both
# Accepted: an http:// or https:// URL
# BRUTOR_MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:9000

# Addresses the bucket as a path (endpoint/bucket), which MinIO and most
# S3-compatible stores need. Set false for AWS S3.
# boolean; default true; edition: both
# Accepted: true, false, 1, 0, yes, no, on, off
# BRUTOR_MEDIA_S3_FORCE_PATH_STYLE_ENABLED=false

# Access key of the media store. Set it together with
# BRUTOR_MEDIA_S3_SECRET_ACCESS_KEY, or set neither and the AWS SDK's own
# credential chain is used (an instance or task role).
# string; no default; edition: both
# Accepted: an access key id
# BRUTOR_MEDIA_S3_ACCESS_KEY_ID=brutor-media

# Secret key of the media store. See BRUTOR_MEDIA_S3_ACCESS_KEY_ID.
# string; no default; secret; edition: both
# Accepted: a secret access key
# BRUTOR_MEDIA_S3_SECRET_ACCESS_KEY=<the secret key of the media store>

# Lifetime, in seconds, of a signed download URL. Never less than 60.
# integer; default 900; edition: both
# Accepted: a whole number of seconds; below 60 is 60
# BRUTOR_MEDIA_SIGNED_URL_TTL_SECS=300

# Directory of the filesystem media store: a volume of its own, mounted into
# the gateway and backed up with the database. Setting it selects the
# filesystem store unless BRUTOR_MEDIA_STORAGE_BACKEND says otherwise. Each
# tenant's files are under a directory of their own; names are ids the gateway
# mints. The gateway creates the directory and refuses to start when it cannot
# write there. One gateway instance only: with several, use s3.
# path; no default; edition: both
# Accepted: an absolute or relative directory path
# BRUTOR_MEDIA_FILESYSTEM_DIR=/var/lib/brutor/media

# Size limit of the filesystem media store, in bytes: the total of the stored
# files. A write that would pass it is refused (HTTP 507, naming this
# variable); the media GC's deletes make room again. Each tenant's own media
# quota still applies within it. Default 10 GiB.
# integer; default 10737418240; edition: both
# Accepted: a whole number of bytes, 1 or more
# BRUTOR_MEDIA_FILESYSTEM_MAX_BYTES=53687091200

# Base URL of the Skill Runner, which runs skill scripts for the gateway. It
# must point at the runner's BRUTOR_SKILL_RUNNER_LISTEN_ADDR.
# url; default http://skill-runner:8210; edition: both
# Accepted: an http:// or https:// URL
# BRUTOR_SKILL_RUNNER_URL=http://localhost:8210

# Secret the gateway signs each execution token for the Skill Runner with.
# Must equal the runner's BRUTOR_SKILL_RUNNER_JWT_SECRET. Unset: the gateway
# starts, and every skill execution fails with a message that names this
# variable.
# string; no default; secret; edition: both
# Accepted: at least 32 characters (the runner refuses a shorter one)
# BRUTOR_SKILL_RUNNER_JWT_SECRET=<output of: openssl rand -hex 32>

# Advanced. Wall-clock limit, in seconds, of a skill script in SANDBOX mode.
# The Skill Runner enforces it; the gateway reads the same variable to wait
# for a run that long plus a margin. Set the same value on both.
# integer; default 30; edition: both
# Accepted: a whole number of seconds, 1 or more
# BRUTOR_SKILL_RUNNER_SANDBOX_TIMEOUT_SECS=60

# Advanced. Wall-clock limit, in seconds, of a skill script in TRUSTED mode.
# The Skill Runner enforces it; the gateway reads the same variable to wait
# for a run that long plus a margin. Set the same value on both.
# integer; default 120; edition: both
# Accepted: a whole number of seconds, 1 or more
# BRUTOR_SKILL_RUNNER_TRUSTED_TIMEOUT_SECS=300

# Outbound policy. Destinations of MCP servers, model endpoints, agents, IdPs,
# webhooks and witnesses at a private address (loopback, RFC 1918,
# carrier-grade NAT, IPv6 unique-local, and a name that resolves to one) are
# refused unless listed here; link-local and cloud metadata addresses are
# refused whatever this says. A host name allows every address it resolves to,
# *.domain the domain and its subdomains, an address or CIDR range those
# addresses. The Control Plane and KB Connector Sync read the same variable.
# list; no default; edition: both
# Accepted: comma-separated host names, *.domain, IP addresses and CIDR ranges
# (no port, scheme or path)
# BRUTOR_OUTBOUND_ALLOW_HOSTS=mcp.internal,*.corp.example,10.20.0.0/16,ollama

# Autonomy level an agent runs at while the governance database cannot be read
# and the gateway has no recent level for it. restricted keeps reads and chat
# serving and holds everything that changes the world; suspended stops the
# agent.
# string; default restricted; edition: both
# Accepted: autonomous, approval_required, restricted or suspended
# BRUTOR_AUTONOMY_FALLBACK_FLOOR=suspended

# Ed25519 seed the gateway signs audit-chain checkpoints with. Unset: the rows
# are still hash-chained, and no checkpoint is signed.
# string; no default; secret; edition: both
# Accepted: exactly 64 hexadecimal characters (32 bytes)
# BRUTOR_AUDIT_SIGNING_KEY=<output of: openssl rand -hex 32>

# Public keys, besides the gateway's own, whose audit-chain checkpoints
# verify: the keys of other and of earlier instances.
# list; no default; edition: both
# Accepted: comma-separated Ed25519 public keys, 64 hexadecimal characters
# each
# BRUTOR_AUDIT_TRUSTED_KEYS=3f9a0c1e5b7d2f4a6c8e0b1d3f5a7c9e1b3d5f7a9c0e2b4d6f8a1c3e5b7d9f0a

# Ed25519 seed of the deployment's evidence key: every governed decision is
# sealed as a signed statement with it. Unset: no record is sealed, traffic is
# unaffected, and the console says so. Before replacing it, add its public key
# to BRUTOR_EVIDENCE_RETIRED_KEYS.
# string; no default; secret; edition: both
# Accepted: exactly 64 hexadecimal characters (32 bytes)
# BRUTOR_EVIDENCE_SIGNING_KEY=<output of: openssl rand -hex 32>

# Public keys of earlier deployment evidence keys. Still published and trusted
# for verification; nothing is signed with them.
# list; no default; edition: both
# Accepted: comma-separated Ed25519 public keys, 64 hexadecimal characters
# each
# BRUTOR_EVIDENCE_RETIRED_KEYS=3f9a0c1e5b7d2f4a6c8e0b1d3f5a7c9e1b3d5f7a9c0e2b4d6f8a1c3e5b7d9f0a

# Stable identity of this deployment. It is hashed into the identifier of
# every tenant's evidence log: set it once and never change it, a new value
# starts new logs.
# string; default default; edition: both
# Accepted: any text
# BRUTOR_DEPLOYMENT_ID=acme-prod

# Issuer written into every signed statement. Unset:
# urn:brutor:deployment:<BRUTOR_DEPLOYMENT_ID>. A deployment that publishes a
# did:web sets it here.
# string; no default; edition: both
# Accepted: a URI
# BRUTOR_EVIDENCE_ISSUER=did:web:gateway.example.com

# A signed tree head is issued for a tenant's evidence log once this many
# entries are not yet covered by one.
# integer; default 100; edition: both
# Accepted: a whole number, 1 or more
# BRUTOR_EVIDENCE_HEAD_CADENCE_ENTRIES=500

# A signed tree head is issued once the oldest entry not yet covered by one is
# this many seconds old. Checked when an entry is appended: an idle log issues
# none.
# integer; default 900; edition: both
# Accepted: a whole number of seconds, 1 or more
# BRUTOR_EVIDENCE_HEAD_CADENCE_SECS=300

# Registers signed tree heads with the tenants' witnesses. An incident kill
# switch: false stops every call to a witness and traffic is unaffected; each
# head issued meanwhile is recorded as unwitnessed (a receipt row with verdict
# skipped per witness, naming this variable, and a warning in the log), so a
# verifier sees standalone heads for that period. Back to true, the retry loop
# submits those heads (up to 30 days old).
# boolean; default true; edition: both
# Accepted: true, false, 1, 0, yes, no, on, off
# BRUTOR_EVIDENCE_WITNESS_ENABLED=false

# Experimental. Serves the Agent Action Capsule export of evidence records,
# which follows an individual Internet-Draft: its format, its route and this
# setting may change or be removed in any release, and a capsule is not
# covered by the evidence compatibility promise (records and bundles are).
# Off: that route answers 404.
# boolean; default false; edition: both
# Accepted: true, false, 1, 0, yes, no, on, off
# BRUTOR_EVIDENCE_PROFILE_AAC_ENABLED=true

# Records Prometheus metrics and serves them at /metrics on
# BRUTOR_METRICS_LISTEN_ADDR. Off: nothing is recorded and that listener is
# not opened.
# boolean; default false; edition: both
# Accepted: true, false, 1, 0, yes, no, on, off
# BRUTOR_METRICS_ENABLED=true

# Address of the /metrics listener, apart from the public one. Bound only when
# BRUTOR_METRICS_ENABLED is true. It has no authentication: the default is
# loopback only. To let a Prometheus on another host (or another container)
# scrape it, set 0.0.0.0:9464 and keep the port on a private network; never
# publish it.
# socket_addr; default 127.0.0.1:9464; edition: both
# Accepted: host:port
# BRUTOR_METRICS_LISTEN_ADDR=0.0.0.0:9464

# OTLP endpoint (gRPC) traces are exported to. Unset: no trace is exported.
# The OpenTelemetry SDK reads its other OTEL_* variables itself.
# string; no default; edition: both
# Accepted: an OTLP endpoint URL
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# service.name of the exported traces.
# string; default brutor-gateway-core; edition: both
# Accepted: a service name
# OTEL_SERVICE_NAME=brutor-gateway-core-eu

# Writes the log as JSON lines, one object per event, for a log collector.
# Off: human-readable lines. RUST_LOG still chooses what is logged.
# boolean; default false; edition: both
# Accepted: true, false, 1, 0, yes, no, on, off
# BRUTOR_LOG_JSON_ENABLED=true

# Log filter. The gateway does not start with a filter that does not parse.
# string; default brutor_gateway_core=info,tower_http=info; edition: both
# Accepted: tracing filter directives (target=level, comma-separated)
# RUST_LOG=brutor_gateway_core=debug,tower_http=info

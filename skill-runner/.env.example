# Brutor Agent Control, Skill Runner (both editions): environment variables
#
# Generated from src/env_vars.rs; do not edit by hand. To regenerate:
#   UPDATE_ENV_DOCS=1 cargo test --test env_registry
#
# Copy to .env and fill in the required values: cp .env.example .env
# The service loads .env from its working directory at start.

# The secret the Core Gateway signs execution tokens with (HS256). The runner
# only verifies tokens. Must equal the Core Gateway's
# BRUTOR_SKILL_RUNNER_JWT_SECRET.
# string; required; secret; edition: both
# Accepted: at least 32 characters
# Example: <output of: openssl rand -hex 32>
BRUTOR_SKILL_RUNNER_JWT_SECRET=

# Address the HTTP server binds. The Core Gateway's BRUTOR_SKILL_RUNNER_URL
# must point at it.
# socket_addr; default 0.0.0.0:8210; edition: both
# Accepted: an IP address and a port (ip:port)
# BRUTOR_SKILL_RUNNER_LISTEN_ADDR=127.0.0.1:8210

# Advanced. Wall-clock limit, in seconds, of a script in SANDBOX mode.
# integer; default 30; edition: both
# Accepted: a whole number of seconds
# BRUTOR_SKILL_RUNNER_SANDBOX_TIMEOUT_SECS=60

# Advanced. Wall-clock limit, in seconds, of a script in TRUSTED mode.
# integer; default 120; edition: both
# Accepted: a whole number of seconds
# BRUTOR_SKILL_RUNNER_TRUSTED_TIMEOUT_SECS=300

# Advanced. Directory under which session workspaces live
# (<root>/<tenant>/<session>). Unset: brutor-skill-workspaces under the
# temporary directory (TMPDIR).
# path; no default; edition: both
# Accepted: a directory the runner can write to
# BRUTOR_SKILL_RUNNER_WORKSPACE_ROOT=/var/lib/brutor/skill-workspaces

# Names of the runner's environment variables a TRUSTED script is handed, when
# set. Setting it replaces the default list. Proxy variables (HTTP_PROXY,
# HTTPS_PROXY, NO_PROXY and the lower-case forms) and
# OTEL_EXPORTER_OTLP_HEADERS may carry credentials and are handed on only when
# named here. The runner's own variables (this table) cannot be added. SANDBOX
# scripts see none.
# list; default OTEL_EXPORTER_OTLP_ENDPOINT,OTEL_SERVICE_NAME,LC_ALL,TZ; edition: both
# Accepted: comma-separated variable names
# BRUTOR_SKILL_RUNNER_TRUSTED_ENV_ALLOWLIST=OTEL_EXPORTER_OTLP_ENDPOINT,OTEL_SERVICE_NAME,LC_ALL,TZ,HTTPS_PROXY,NO_PROXY

# Write each log line as one JSON object (time, level, target, span, fields),
# for a log pipeline. false: human-readable text lines with the same fields.
# boolean; default false; edition: both
# Accepted: true or false (also 1/0, yes/no, on/off)
# BRUTOR_LOG_JSON_ENABLED=true

# Log filter. A filter that does not parse is replaced by the default.
# string; default brutor_skill_runner=info,tower_http=info; edition: both
# Accepted: tracing filter directives (target=level, comma-separated)
# RUST_LOG=brutor_skill_runner=debug,tower_http=info

# The platform's temporary directory. Only the default of
# BRUTOR_SKILL_RUNNER_WORKSPACE_ROOT uses it. Unset: the platform default
# (/tmp).
# path; no default; edition: both
# Accepted: a directory
# TMPDIR=/tmp

{
 "editions": {
  "community": {
   "lines": [
    "Copyright 2026 Brutor AI Ltd.",
    "SPDX-License-Identifier: Apache-2.0"
   ],
   "forbidden_in_leading_region": [
    "Proprietary and Confidential",
    "proprietary and confidential",
    "All rights reserved",
    "LicenseRef-Brutor-Proprietary"
   ]
  },
  "enterprise": {
   "lines": [
    "Copyright 2026 Brutor AI Ltd. All rights reserved.",
    "SPDX-License-Identifier: LicenseRef-Brutor-Proprietary"
   ],
   "forbidden_in_leading_region": [
    "SPDX-License-Identifier: Apache-2.0",
    "Proprietary and Confidential",
    "Licensed under the Apache License"
   ]
  }
 },
 "company_holders": [
  "Brutor AI Ltd",
  "Brutor AI Limited"
 ],
 "legacy_sentences": [
  "Proprietary and Confidential.",
  "All information contained herein is, and remains the property of Brutor AI Ltd.",
  "Dissemination of this information or reproduction of this material is strictly forbidden unless prior written permission is obtained from Brutor AI Ltd.",
  "THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND.",
  "This software is proprietary and confidential.",
  "Unauthorized copying, distribution, or use of this software, via any medium, is strictly prohibited."
 ],
 "syntax_by_extension": {
  ".rs": "rust",
  ".py": "python",
  ".ts": "js",
  ".tsx": "js",
  ".js": "js",
  ".jsx": "js",
  ".mjs": "js",
  ".cjs": "js",
  ".sh": "shell",
  ".ps1": "powershell",
  ".sql": "sql",
  ".css": "css",
  ".html": "html"
 },
 "syntax_by_name_glob": {
  "Dockerfile": "docker",
  "Dockerfile.*": "docker",
  "*.Dockerfile": "docker"
 },
 "syntax_by_path_glob": {
  "/.github/workflows/*.yml": "yaml",
  "/.github/workflows/*.yaml": "yaml"
 },
 "styles": {
  "rust": {
   "line": "// "
  },
  "python": {
   "line": "# "
  },
  "shell": {
   "line": "# "
  },
  "powershell": {
   "line": "# "
  },
  "yaml": {
   "line": "# "
  },
  "docker": {
   "line": "# "
  },
  "sql": {
   "line": "-- "
  },
  "js": {
   "open": "/*",
   "line": " * ",
   "close": " */"
  },
  "css": {
   "open": "/*",
   "line": " * ",
   "close": " */"
  },
  "html": {
   "open": "<!--",
   "line": "  ",
   "close": "-->"
  }
 },
 "exclusions": [
  {
   "id": "X1-lock",
   "reason": "lock files are written by the package manager",
   "path_globs": [
    "*/Cargo.lock",
    "*/package-lock.json",
    "*/yarn.lock",
    "*/pnpm-lock.yaml",
    "*/poetry.lock",
    "*/uv.lock",
    "*.lock"
   ]
  },
  {
   "id": "X2-vendored",
   "reason": "third-party material kept as received: its own licence stands",
   "path_globs": [
    "*/node_modules/*",
    "*/vendor/*",
    "*/third_party/*",
    "*/crates/brutor-aac/vectors/*",
    "*/witness/upstream/*"
   ]
  },
  {
   "id": "X3-snapshot",
   "reason": "snapshots are written by the test runner and compared byte for byte",
   "path_globs": [
    "*/__snapshots__/*",
    "*.snap"
   ]
  },
  {
   "id": "X4-fixture",
   "reason": "fixtures are test inputs compared or parsed byte for byte (hand-written source modules under a fixtures directory are named in force_include and do carry a header)",
   "path_globs": [
    "*/fixtures/*",
    "*/testdata/*",
    "*/test_data/*",
    "*/golden/*"
   ]
  },
  {
   "id": "X5-generated-path",
   "reason": "generated output: the generator, not this tool, decides its first lines",
   "path_globs": [
    "*/src/lib/generated/*",
    "*/dist/*",
    "*/build/*",
    "*/target/*",
    "*.min.js",
    "*.min.css",
    "*.pb.rs",
    "*_pb2.py"
   ]
  },
  {
   "id": "X6-generated-marker",
   "reason": "generated output: one of the first 5 lines carries a generated-file marker",
   "content_markers_first_lines": 5,
   "content_markers": [
    "@generated",
    "DO NOT EDIT",
    "GENERATED FILE",
    "GENERATED by ",
    "auto-generated by",
    "Code generated by",
    "This file was automatically generated",
    "PostgreSQL database dump"
   ]
  },
  {
   "id": "X7-empty",
   "reason": "a file with no content (0 bytes or white space only) has nothing to license",
   "empty": true
  }
 ],
 "force_include": [
  "*/__tests__/fixtures/*.ts",
  "*/__tests__/fixtures/*.tsx"
 ],
 "non_source_extensions": [
  ".json",
  ".jsonl",
  ".md",
  ".mdx",
  ".txt",
  ".toml",
  ".yml",
  ".yaml",
  ".hcl",
  ".ini",
  ".cfg",
  ".conf",
  ".lock",
  ".svg",
  ".png",
  ".jpg",
  ".jpeg",
  ".gif",
  ".ico",
  ".webp",
  ".webmanifest",
  ".pdf",
  ".cose",
  ".crt",
  ".pem",
  ".tsr",
  ".sha256",
  ".bin",
  ".proto",
  ".mako",
  ".log",
  ".csv",
  ".example",
  ".baseline",
  ".snap",
  ".map",
  ".woff",
  ".woff2",
  ".ttf",
  ".env",
  ".template",
  ".tmpl",
  ".hbs"
 ],
 "non_source_names": [
  "LICENSE",
  "NOTICE",
  "LICENSE_HEADER.txt",
  "SHA256SUMS",
  "MANIFEST.json",
  ".gitignore",
  ".dockerignore",
  ".gitattributes",
  ".nvmrc",
  ".python-version",
  ".coverage",
  ".coverage-floor",
  ".upstream-root",
  ".editorconfig",
  ".npmrc",
  ".prettierrc",
  "Makefile",
  "CODEOWNERS",
  "LICENSE-upstream-BSD-3-Clause",
  ".env",
  "editions.yaml",
  "Dockerfile.dockerignore",
  "THIRD_PARTY_LICENSES"
 ]
}

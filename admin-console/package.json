{
  "name": "brutor-agent-control-admin-console",
  "version": "0.11.32",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 2665",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:api-types:control": "node scripts/gen-control-plane-types.mjs community",
    "gen:api-types:core": "openapi-typescript ../brutor-gateway-core/openapi/proxy-openapi.json -o src/lib/generated/core-proxy-api.d.ts",
    "gen:api-types": "npm run gen:api-types:control && npm run gen:api-types:core",
    "gen:env-docs": "node scripts/gen-env-docs.mjs",
    "lint:fix": "eslint . --fix --rule '{\"@typescript-eslint/no-unnecessary-type-assertion\":\"off\"}'",
    "lint:report": "eslint . --format json | node scripts/lint-report.mjs",
    "type-check": "tsc --noEmit && npm run type-check:tests",
    "type-check:tests": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "scan:bundle": "node scripts/scan-community-bundle.mjs dist",
    "licenses:check": "node scripts/third-party-licenses.mjs check dist/THIRD_PARTY_LICENSES THIRD_PARTY_LICENSES",
    "licenses:update": "node scripts/third-party-licenses.mjs update dist/THIRD_PARTY_LICENSES THIRD_PARTY_LICENSES",
    "enterprise:licenses:check": "npm run licenses:check -w enterprise",
    "enterprise:licenses:update": "npm run licenses:update -w enterprise",
    "enterprise:dev": "npm run dev -w enterprise",
    "enterprise:build": "npm run build -w enterprise",
    "enterprise:type-check": "npm run type-check -w enterprise",
    "enterprise:type-check:tests": "npm run type-check:tests -w enterprise",
    "enterprise:lint": "npm run lint -w enterprise",
    "enterprise:gen:api-types:control": "npm run gen:api-types:control -w enterprise",
    "enterprise:lint:report": "npm run lint:report -w enterprise",
    "enterprise:test": "npm run test -w enterprise",
    "enterprise:test:run": "npm run test:run -w enterprise",
    "enterprise:test:coverage": "npm run test:coverage -w enterprise",
    "all:type-check": "npm run type-check && npm run enterprise:type-check",
    "all:lint": "npm run lint && npm run enterprise:lint",
    "all:build": "npm run build && npm run enterprise:build",
    "all:licenses:check": "npm run licenses:check && npm run enterprise:licenses:check",
    "all:test": "npm run test:run && npm run enterprise:test:run",
    "all:test:coverage": "npm run test:coverage && npm run enterprise:test:coverage"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-is": "^19.2.8",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "autoprefixer": "^10.4.14",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.8.9",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.27",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}

# Brutor Agent Control Admin Console: environment for a run from source.
#
# Generated from src/envRegistry.json by scripts/gen-env-docs.mjs. Do not edit it by hand.
#
# Copy to .env and adjust:
#   cp .env.example .env
#
# Both packages (Community at the root, Enterprise in enterprise/) read this
# file. A value prefixed VITE_ is embedded in the bundle the browser downloads:
# put no secret here. In a container the same settings are given to the
# container under their BRUTOR_ names (README.md, "Configure").

# Base URL of the Control Plane (the admin API), as the browser reaches it.
# Every /v1/admin/* call goes there. The Control Plane is given the same value
# under the same name. In a container: BRUTOR_CONTROL_PLANE_PUBLIC_URL.
VITE_CONTROL_PLANE_PUBLIC_URL=http://localhost:5050

# Base URL of the Core Gateway, as the browser reaches it. Used for the
# gateway addresses the console shows (MCP, model and agent endpoints) and for
# the health probes it calls directly. The Core Gateway is given the same
# value under the same name. In a container: BRUTOR_GATEWAY_PUBLIC_URL.
VITE_GATEWAY_PUBLIC_URL=http://localhost:8100

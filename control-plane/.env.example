# Brutor Agent Control, Control Plane (Community Edition): environment variables
#
# Generated from app/env_vars.py; do not edit by hand. To regenerate:
#   python scripts/gen_env_docs.py
#
# Copy to .env and fill in the required values: cp .env.example .env
# The service loads .env from its working directory at start.

# PostgreSQL connection string of the installation's database. The Control
# Plane creates and migrates the schema there at start; the Core Gateway and
# the worker services read the same database. TLS towards PostgreSQL is set in
# the URL with libpq's own parameters
# (`?sslmode=verify-full&sslrootcert=/path/root.crt`, and `sslcert`, `sslkey`
# for a client certificate), as for the Core Gateway; the Control Plane never
# replaces them.
# url; required; secret; edition: both
# Accepted: a postgresql:// URL
# Example: postgresql://<user>:<password>@localhost:5432/<database>
DATABASE_URL=

# Secret the Control Plane signs administrator sessions with. Must equal the
# Core Gateway's JWT_SECRET. A value from an example file is refused.
# string; required; secret; edition: both
# Accepted: at least 32 characters, not a placeholder
# Example: <output of: openssl rand -hex 32>
JWT_SECRET=

# Encrypts the credentials the Control Plane stores (provider keys, MCP server
# tokens, OAuth client secrets). Must equal the Core Gateway's ENCRYPTION_KEY,
# which decrypts them. A value from an example file is refused.
# string; required; secret; edition: both
# Accepted: at least 32 characters, not a placeholder
# Example: <output of: openssl rand -hex 32>
ENCRYPTION_KEY=

# Redis (or Valkey) the Control Plane publishes cache invalidations on, so
# that the Core Gateway applies a configuration change at once. Must be the
# gateway's Redis. Unset: nothing is published and the gateway picks changes
# up when its caches expire.
# url; no default; secret; edition: both
# Accepted: a redis:// or rediss:// URL
# REDIS_URL=redis://<host>:6379/0

# Password of the administrator the first start creates. There is no default:
# the first start is refused without it. Read only when the account has to be
# created; changing it later does not change the account's password.
# string; no default; secret; edition: both
# Accepted: a password
# BRUTOR_DEFAULT_TENANT_ADMIN_PASSWORD=<a password of your own>

# User name of the administrator the first start creates in the default
# tenant, and, in the Enterprise Edition, of the first administrator of a
# tenant created without one named.
# string; default admin; edition: both
# Accepted: a user name
# BRUTOR_DEFAULT_TENANT_ADMIN_USERNAME=admin

# Email address of the administrator the first start creates.
# string; default admin@example.com; edition: both
# Accepted: an email address
# BRUTOR_DEFAULT_TENANT_ADMIN_EMAIL=admin@example.com

# Base URL of the Core Gateway as the Control Plane reaches it: every call it
# makes to the gateway (evidence, model probes, health checks, approvals) goes
# there. The default serves a gateway run on the same machine; a container
# sets the gateway's service address.
# url; default http://127.0.0.1:8100; edition: both
# Accepted: an http:// or https:// URL
# BRUTOR_GATEWAY_INTERNAL_URL=http://core:8100

# API key the Control Plane presents to the Core Gateway on every call it
# makes to it. The Control Plane registers it in the database at the first
# start, where the gateway finds it; the KB Uploader is given the same
# variable. Unset at the first start: a key is generated and written to the
# log once, to be set here; while it is unset the Control Plane's own calls to
# the gateway carry no key.
# string; no default; secret; edition: both
# Accepted: a long random string
# BRUTOR_GATEWAY_SERVICE_API_KEY=<output of: openssl rand -hex 32>

# Base URL of the Control Plane as a browser reaches it. Reported by GET / and
# in the start banner. The Admin Console is given the same value under the
# same name. Unset: http:// and BRUTOR_CONTROL_PLANE_LISTEN_ADDR.
# url; no default; edition: both
# Accepted: an http:// or https:// URL
# BRUTOR_CONTROL_PLANE_PUBLIC_URL=https://control.example.com

# Origins that may call the admin API from a browser: the Admin Console's. The
# Core Gateway reads the same variable.
# list; default http://localhost:3001,http://localhost:3002; edition: both
# Accepted: comma-separated origins (scheme://host[:port])
# BRUTOR_CORS_ORIGINS=https://admin.example.com,https://portal.example.com

# Reverse proxies whose forwarded headers are believed. A request's client IP
# (audit rows, sessions, dynamic client registration) is the connecting
# address unless that address is listed; then it is the right-most
# X-Forwarded-For address that is not itself listed. X-Forwarded-Proto and
# X-Forwarded-Host are used only from a listed proxy. Unset: no forwarded
# header is believed, and behind a proxy the proxy's address is recorded. The
# Core Gateway reads the same variable.
# list; no default; edition: both
# Accepted: comma-separated IP addresses and CIDR ranges (no host names, no *)
# BRUTOR_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10

# Algorithm of the tokens signed with JWT_SECRET. Must equal the Core
# Gateway's JWT_ALGORITHM.
# string; default HS256; edition: both
# Accepted: HS256, HS384 or HS512
# JWT_ALGORITHM=HS512

# Address the Control Plane's HTTP server binds, under Gunicorn (every image)
# and under `python main.py` (where --listen-addr takes precedence).
# string; default 0.0.0.0:5050; edition: both
# Accepted: host:port (an IPv6 address in brackets, [::]:5050), port 1 to
# 65535
# BRUTOR_CONTROL_PLANE_LISTEN_ADDR=127.0.0.1:5050

# Version the Control Plane reports (GET /, the OpenAPI document) and records
# with what it measures. The images set it at build time; the packages set it
# to the version of the package.
# string; default dev; edition: both
# Accepted: a version string
# BRUTOR_VERSION=1.4.0

# Lowest level the Control Plane logs, under Gunicorn and under `python
# main.py` (where --log-level takes precedence). Gunicorn's own messages
# follow the same level. `warn` and `warning` are the same level, so that one
# value serves the Python and the Rust services of a package.
# string; default INFO; edition: both
# Accepted: DEBUG, INFO, WARN or WARNING, ERROR or CRITICAL (any case)
# BRUTOR_LOG_LEVEL=DEBUG

# Writes the Control Plane's log as one JSON object per line instead of text,
# under Gunicorn and under `python main.py` (where --json-logs also switches
# it on).
# boolean; default false; edition: both
# Accepted: true, false, 1, 0, yes, no, on, off
# BRUTOR_LOG_JSON_ENABLED=true

# Advanced. Connections each Control Plane worker keeps open to PostgreSQL;
# under load a worker opens as many again, closed when idle. With
# GUNICORN_WORKERS it bounds the connections the Control Plane can hold:
# workers x 2 x pool size, which must stay below PostgreSQL's max_connections
# together with the Core Gateway's pool.
# integer; default 20; edition: both
# Accepted: a whole number, 1 or more
# BRUTOR_CONTROL_PLANE_DB_POOL_SIZE=10

# Advanced. Seconds a statement may run before PostgreSQL cancels it
# (statement_timeout). Migrations at start are not bound by it.
# integer; default 60; edition: both
# Accepted: a whole number of seconds, 1 or more
# BRUTOR_DB_COMMAND_TIMEOUT_SECS=120

# Size of the Core Gateway's PostgreSQL pool: the gateway's own setting, given
# to the Control Plane under the same name so that its bulk operations against
# the gateway (health checks of many models) stay inside it.
# integer; default 20; edition: both
# Accepted: a whole number, 1 or more
# BRUTOR_GATEWAY_DB_POOL_SIZE=50

# The installation's fallback embedding model, by name: used only for a tenant
# that has no default embedding model. A new tenant that has a model of this
# name is given it as its default. The Core Gateway and the KB Uploader are
# given the same variable and resolve in the same order (the tenant's default
# first), so that a query is embedded with the model its documents were. There
# is no default: with neither, an embedding is refused.
# string; no default; edition: both
# Accepted: a model name
# BRUTOR_EMBEDDING_MODEL=text-embedding-3-small

# Model name a new tenant gets as its default judge model (LLM-judged
# assurance checks), when the tenant has a model of that name. Unset: the
# seed's own choice.
# string; no default; edition: both
# Accepted: a model name
# BRUTOR_DEFAULT_JUDGE_MODEL=claude-haiku-5-5

# Address the seeded Ollama models are registered with: where the Core Gateway
# reaches Ollama.
# url; default http://localhost:11434; edition: both
# Accepted: an http:// or https:// URL
# BRUTOR_OLLAMA_BASE_URL=http://ollama:11434

# Address of the sample A2A agent (the Enterprise trial's samples/a2a): where
# the Core Gateway reaches it. Set, a new tenant is seeded with the sample's
# agent card (hello-world-a2a) carrying this address; the gateway calls it
# only when the outbound policy allows the host (BRUTOR_OUTBOUND_ALLOW_HOSTS).
# Unset: no sample card is seeded.
# url; no default; edition: both
# Accepted: an http:// or https:// URL
# BRUTOR_A2A_SAMPLE_PUBLIC_URL=http://a2a-sample:9100

# MCP servers every new tenant is registered with: a JSON array of objects
# with `slug` and `base_url`, and optionally `name`, `description`,
# `auth_type`, `auth_token`, `timeout`, `icon`. An `auth_token` may name
# another variable as ${NAME}; the token is stored encrypted.
# string; no default; edition: both
# Accepted: a JSON array of objects
# BRUTOR_SHARED_MCP_SERVERS=[{"slug":"map","base_url":"http://mcp-app-map:8000/mcp"}]

# Address of the witness service that runs beside this installation. Set, the
# witness is registered at start so that the Core Gateway has evidence tree
# heads countersigned there. Unset or empty: no witness is registered.
# url; no default; edition: both
# Accepted: an http:// or https:// URL, or empty for none
# BRUTOR_LOCAL_WITNESS_URL=http://witness:8000

# Public key of the local witness, pinned. Unset: the key is fetched from the
# witness when it is first registered.
# string; no default; edition: both
# Accepted: 64 hexadecimal characters (an Ed25519 public key)
# BRUTOR_LOCAL_WITNESS_PINNED_KEY=3b6a27bcceb6a42d62a3a8d02a6f0d73653215771de243a63ac048a18b59da29

# Who operates the local witness, as the witness list shows it.
# string; default brutor-witness (this deployment, same operator); edition: both
# Accepted: text
# BRUTOR_LOCAL_WITNESS_OPERATOR=Example Corp platform team

# Outbound policy. Destinations of MCP servers, model endpoints, agents, IdPs,
# webhooks, registries and witnesses at a private address (loopback, RFC 1918,
# carrier-grade NAT, IPv6 unique-local, and a name that resolves to one) are
# refused unless listed here; link-local and cloud metadata addresses are
# refused whatever this says. A host name allows every address it resolves to,
# *.domain the domain and its subdomains, an address or CIDR range those
# addresses. The Core Gateway and KB Connector Sync read the same variable.
# list; no default; edition: both
# Accepted: comma-separated host names, *.domain, IP addresses and CIDR ranges
# (no port, scheme or path)
# BRUTOR_OUTBOUND_ALLOW_HOSTS=mcp.internal,*.corp.example,10.20.0.0/16,ollama

# GitHub token the skill-source sync reads repositories with. Unset: GitHub's
# anonymous rate limit applies and private repositories cannot be read.
# string; no default; secret; edition: both
# Accepted: a GitHub personal access token
# BRUTOR_GITHUB_TOKEN=<a GitHub token with read access to the repositories>

# API key of the Resend account the Control Plane sends email with (the
# welcome message of a new user, the notice that two-factor sign-in was
# switched on). Unset: no email is sent.
# string; no default; secret; edition: both
# Accepted: a Resend API key
# BRUTOR_RESEND_API_KEY=<a Resend API key>

# Sender address of the email the Control Plane sends. A domain verified with
# Resend.
# string; default noreply@brutor.ai; edition: both
# Accepted: an email address
# BRUTOR_RESEND_FROM_EMAIL=noreply@example.com

# Advanced. Worker processes. The Control Plane serves administrators, not
# traffic: 2 is enough for most installations. Each worker has its own
# database pool. Every other Gunicorn setting is fixed.
# integer; default 2; edition: both
# Accepted: a whole number, 1 or more
# GUNICORN_WORKERS=4

# =============================================================================
# Brutor Agent Control Community Edition - configuration
#
# Docker Compose reads this file. A package downloaded from brutor.ai has
# every value below filled in, unique to that download. From a clone of the
# source repository the generated values are empty: run ./start.sh (or
# .\start.ps1) once and it fills them in.
#
# Keep this file. The database is encrypted with ENCRYPTION_KEY and signed
# records carry the evidence keys: a stack started with a different .env
# cannot read data written with this one.
# =============================================================================

# Image tag of the control plane, core gateway, Admin Console, skill runner
# and witness.
BRUTOR_VERSION=0.11.32

# Where the images are pulled from. Uncomment to use your own registry or
# locally built images.
# BRUTOR_REGISTRY=ghcr.io/brutor-ai

# -----------------------------------------------------------------------------
# Ports on this host
# -----------------------------------------------------------------------------
BRUTOR_ADMIN_CONSOLE_PORT=3002
BRUTOR_CONTROL_PLANE_PORT=5050
# The core gateway. The Admin Console shows this port in its endpoint dialogs.
BRUTOR_GATEWAY_PORT=8100
# The database and the witness: on loopback only, whatever BIND_ADDRESS says.
# Valkey, the key-value store, is not published at all.
DB_PORT=5432
WITNESS_PORT=8300

# Everything is published on loopback only. To reach the Admin Console, the
# control plane and the gateway from another machine set BIND_ADDRESS=0.0.0.0
# (it opens those three ports and nothing else; put TLS or a reverse proxy in
# front), and set BRUTOR_CONTROL_PLANE_PUBLIC_URL, BRUTOR_GATEWAY_PUBLIC_URL
# (and BRUTOR_CORS_ORIGINS) to the addresses your browser uses.
# BIND_ADDRESS=0.0.0.0
# The Control Plane, as your browser reaches it.
# BRUTOR_CONTROL_PLANE_PUBLIC_URL=http://localhost:5050
# The Core Gateway, as your browser and your agents reach it.
# BRUTOR_GATEWAY_PUBLIC_URL=http://localhost:8100
# The origins a browser may call the Control Plane and the gateway from: the
# address of the Admin Console.
# BRUTOR_CORS_ORIGINS=http://localhost:3002

# Behind a reverse proxy: the control plane and the gateway take the client's
# address (audit logs, IP rate limits) and the scheme and host (links they
# build) from X-Forwarded-For, -Proto and -Host only when the request comes
# from an address listed here. Empty (the default, no proxy in this package):
# no forwarded header is believed. List your proxy's address as the
# containers see it, as IP addresses or CIDR ranges, comma-separated: a proxy
# container on the network brutor-network, or for a proxy on this host the
# network's gateway (docker network inspect brutor-network shows the subnet
# and the gateway). Never 0.0.0.0/0.
# BRUTOR_TRUSTED_PROXIES=172.18.0.0/16

# -----------------------------------------------------------------------------
# Logging: one level and one switch for every service. The level is one of
# error, warn, info or debug. With the switch true, the control plane, the
# gateway and the skill runner write one JSON object per line, not text.
# -----------------------------------------------------------------------------
BRUTOR_LOG_LEVEL=info
BRUTOR_LOG_JSON_ENABLED=false

# -----------------------------------------------------------------------------
# Outbound destinations
#
# The control plane and the gateway refuse an MCP server, model endpoint,
# agent, identity provider, webhook or witness at a private address (loopback,
# 10.x, 172.16-31.x, 192.168.x, IPv6 unique-local, and a name that resolves to
# one) unless it is listed here; cloud metadata and link-local addresses are
# refused whatever this says. This is the defence against server-side request
# forgery. The package lists the one bundled service it uses: the witness.
# To add an internal MCP server or model endpoint, append its host name,
# *.domain, IP address or CIDR range (no scheme, port or path), for example
#   BRUTOR_OUTBOUND_ALLOW_HOSTS=witness,mcp.internal,*.corp.example,10.20.0.0/16
# A refused URL is reported as "outbound destination '<host>' refused: ...".
# -----------------------------------------------------------------------------
BRUTOR_OUTBOUND_ALLOW_HOSTS=witness

# -----------------------------------------------------------------------------
# Media: the files users upload and models generate. The gateway keeps them
# on the Docker volume brutor-media (back it up with the database) and serves
# their download links itself, built from BRUTOR_GATEWAY_PUBLIC_URL above.
# The size limit of the store, in bytes (10 GiB): a write that would pass it
# is refused, and deleting media makes room again. To keep media in an
# S3-compatible store instead, give the core service in docker-compose.yml the
# backend s3 (BRUTOR_MEDIA_STORAGE_BACKEND) and the BRUTOR_MEDIA_S3_* settings
# (the configuration reference on docs.brutor.ai lists them).
# -----------------------------------------------------------------------------
BRUTOR_MEDIA_FILESYSTEM_MAX_BYTES=10737418240

# -----------------------------------------------------------------------------
# The embedding model, by name, for a tenant that has no default embedding
# model. The control plane and the gateway are given this one value.
# -----------------------------------------------------------------------------
BRUTOR_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# First sign-in to the Admin Console (http://localhost:3002)
#
# Read once, when the database is empty. Changing them later does not change
# the account: change the password in the Admin Console instead. This is the
# only account the installation starts with.
# -----------------------------------------------------------------------------
BRUTOR_DEFAULT_TENANT_ADMIN_USERNAME=admin
BRUTOR_DEFAULT_TENANT_ADMIN_PASSWORD=
BRUTOR_DEFAULT_TENANT_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_USER=brutor
DB_NAME=brutor
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Generated secrets. Do not change one once the stack holds data.
# -----------------------------------------------------------------------------
# Signs admin and gateway tokens (control plane and core gateway).
JWT_SECRET=
# Protects stored provider keys (control plane and core gateway).
ENCRYPTION_KEY=
# The control plane's key for calling the core gateway.
BRUTOR_GATEWAY_SERVICE_API_KEY=
# Core gateway to skill runner.
BRUTOR_SKILL_RUNNER_JWT_SECRET=
# Compliance evidence: the gateway's signing key and the witness's signing
# key (each exactly 64 hex characters), and this installation's id.
BRUTOR_EVIDENCE_SIGNING_KEY=
BRUTOR_WITNESS_SIGNING_KEY=
BRUTOR_DEPLOYMENT_ID=
# Audit chain: the gateway's key for signing checkpoints over the audit
# records (64 hex characters). Separate from the evidence key: each signs its
# own records and is rotated on its own.
BRUTOR_AUDIT_SIGNING_KEY=

# Rotating a signing key: never replace it in place. Put the old key's public
# key (64 hex characters) on its list below, comma-separated, then set the
# new key and restart. What the old key signed keeps verifying; remove an
# entry only when no record it signed is kept. The procedure, step by step:
# docs.brutor.ai, Compliance > Signed statements.
# BRUTOR_AUDIT_TRUSTED_KEYS=
# BRUTOR_EVIDENCE_RETIRED_KEYS=
